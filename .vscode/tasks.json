{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Firmware",
            "type": "shell",
            "command": "cmake --build --preset Debug",
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "Build + Flash Firmware",
            "type": "shell",
            "command": "${workspaceFolder}/build_and_flash.sh",
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}